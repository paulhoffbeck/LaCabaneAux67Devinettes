// les listes sont en JSON dans des String, comme ça ça marche en SQLite et en Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// isTheme = le label apparait dans les quiz à thème de l'accueil
model Label {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  isTheme   Boolean    @default(true)
  questions Question[]
  proposals Proposal[]
}

model Question {
  id              Int      @id @default(autoincrement())
  type            String // "choice" = QCM, "text" = réponse libre
  text            String
  choices         String? // les 4 réponses en JSON
  answerIndex     Int? // index de la bonne réponse, de 0 à 3
  acceptedAnswers String? // ex : ["Napoléon", "Bonaparte"]
  labels          Label[]
  createdAt       DateTime @default(now())
}

model DailyQuiz {
  date        String @id // genre "2026-10-22", heure de Paris
  questionIds String // ids des 10 questions du jour
}

model Score {
  id         Int       @id @default(autoincrement())
  nickname   String
  date       String
  score      Int       @default(0)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([nickname, date])
  @@index([date, score])
}

model Proposal {
  id              Int       @id @default(autoincrement())
  nickname        String
  date            String
  type            String
  text            String
  choices         String?
  answerIndex     Int?
  acceptedAnswers String?
  labels          Label[]
  status          String    @default("pending") // pending, approved ou rejected
  rejectReason    String?
  reviewedBy      String?
  questionId      Int?
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  @@index([nickname, date])
  @@index([status])
}
